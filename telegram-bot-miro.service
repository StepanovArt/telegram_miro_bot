[Unit]
Description=Telegram → Miro inbox bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/telegram-bot-miro
ExecStart=/home/YOUR_USER/telegram-bot-miro/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10
EnvironmentFile=/home/YOUR_USER/telegram-bot-miro/.env

[Install]
WantedBy=multi-user.target
